! ==========================================================
! ===== Sections « professionnels » vs « grand public » =====
! ==========================================================
! MSD / Merck Manuals : versions professionnelles boostées, versions grand public rétrogradées
/professional/$boost=4,site=msdmanuals.com
/professional/$boost=4,site=merckmanuals.com
/accueil/$downrank=3,site=msdmanuals.com
/home/$downrank=3,site=msdmanuals.com
/home/$downrank=3,site=merckmanuals.com
! Ameli : espace professionnels
/medecin/$boost=3,site=ameli.fr
/pharmacien/$boost=3,site=ameli.fr
! Patient.info : section professionnelle
/doctor/$boost=3,site=patient.info

! ===== Motifs d'URL typiques =====
/recommandations/$boost=2
/guidelines/$boost=2
/guideline/$boost=2
/doi/$boost=1

